<view class="page">
  <view class="check-wrap {{celebrate ? 'celebrate' : ''}}">
    <view class="orbit orbit-one"></view>
    <view class="orbit orbit-two"></view>
    <view class="particle p1"></view>
    <view class="particle p2"></view>
    <view class="particle p3"></view>
    <view class="particle p4"></view>
    <view class="particle p5"></view>
    <view class="particle p6"></view>
    <view class="particle p7"></view>
    <view class="particle p8"></view>
    <button class="check-button {{checked ? 'checked' : ''}}" bindtap="checkIn" hover-class="pressing">
      <view class="button-face">
        <text class="button-symbol">{{checked ? '✓' : '打卡'}}</text>
      </view>
    </button>
  </view>

  <view class="calendar">
    <view class="month">{{monthLabel}}</view>
    <view class="calendar-grid labels">
      <text wx:for="{{weekLabels}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="calendar-grid days">
      <view wx:for="{{monthDays}}" wx:key="key" class="day {{item.empty ? 'empty' : ''}} {{item.checked ? 'checked' : ''}} {{item.today ? 'today' : ''}}">
        <text wx:if="{{!item.empty}}">{{item.day}}</text>
      </view>
    </view>
  </view>

  <button wx:if="{{checked}}" class="save-button" bindtap="savePoster">
    <text class="save-icon">↓</text>
    <text>保存打卡图</text>
  </button>

  <canvas class="poster-canvas" canvas-id="posterCanvas" width="750" height="1000"></canvas>
</view>

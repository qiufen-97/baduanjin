.hero{margin:54rpx 0 24rpx;padding:40rpx;border-radius:46rpx;background:#294b3f;color:#fff;box-shadow:0 24rpx 60rpx rgba(41,75,63,.16)}
.hero.done{background:#9f5549}
.label{opacity:.7;font-size:24rpx}
.hero-title{font-family:serif;font-size:48rpx;margin:18rpx 0 10rpx}
.hero-copy{opacity:.7;font-size:25rpx;margin-bottom:38rpx}
.hero-btn{background:#fffdf8!important;color:#294b3f!important;border-radius:28rpx}
.mark{width:82rpx;height:82rpx;border:1rpx solid #9eb1a8;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:serif;font-size:38rpx}
.quick{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}
.quick button{background:rgba(255,253,248,.65);border-radius:28rpx;color:#426858;font-size:36rpx;padding:24rpx}
.quick text{display:block;color:#24332d;font-size:24rpx;margin-top:8rpx}
.section{margin-top:52rpx}
.section-title{font-size:34rpx;font-weight:600}
.week{display:grid;grid-template-columns:repeat(7,1fr);text-align:center;margin-top:26rpx}
.dayname{font-size:21rpx;color:#78827c}
.dot{width:56rpx;height:56rpx;line-height:56rpx;border-radius:50%;background:#ebe4d7;margin:14rpx auto;font-size:22rpx}
.dot.complete,.cell.complete{background:#426858;color:#fff}
.dot.partial,.cell.partial{background:#dce7df}
.dot.today,.cell.today{outline:3rpx solid #c66d5b}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:16rpx;margin-top:28rpx}
.stats view{background:rgba(255,253,248,.66);padding:26rpx 8rpx;border-radius:28rpx;text-align:center}
.stats b{display:block;font-family:serif;font-size:38rpx;color:#294b3f}
.stats text{font-size:21rpx;color:#78827c}
.tabbar{position:fixed;z-index:10;left:0;right:0;bottom:0;display:flex;justify-content:space-around;background:rgba(255,253,248,.96);padding:14rpx 40rpx calc(18rpx + env(safe-area-inset-bottom));border-top:1rpx solid #ebe4d7}
.tabbar button{margin:0;background:transparent;color:#9aa09d;font-size:34rpx;line-height:1}
.tabbar text{display:block;font-size:20rpx;margin-top:10rpx}
.tabbar .active{color:#294b3f}
.mode{display:grid;grid-template-columns:86rpx 1fr 30rpx;align-items:center;gap:20rpx;background:rgba(255,253,248,.7);border-radius:34rpx;text-align:left;margin-top:22rpx;padding:28rpx}
.mode b{width:78rpx;height:78rpx;border-radius:24rpx;background:#dce7df;color:#294b3f;display:flex;align-items:center;justify-content:center}
.mode strong,.move strong{display:block;font-size:29rpx}
.mode text,.move text{display:block;color:#78827c;font-size:22rpx;margin-top:8rpx}
.mode i,.move i{font-style:normal;color:#78827c;font-size:22rpx}
.video-box,.video-empty{height:400rpx;border-radius:36rpx;overflow:hidden;background:#18221e;margin:42rpx 0 20rpx}
.video-box video{width:100%;height:100%}
.video-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff}
.video-empty text{opacity:.55;font-size:22rpx;margin-top:12rpx}
.video-meta{font-size:22rpx;color:#78827c;margin-bottom:44rpx}
.moves{margin:38rpx 0}
.move{display:grid;grid-template-columns:56rpx 1fr 80rpx;gap:18rpx;align-items:center;background:rgba(255,253,248,.7);padding:26rpx 22rpx;margin-bottom:16rpx;border-radius:30rpx}
.move.checked{background:#dce7df}
.check{width:50rpx;height:50rpx;border:1rpx solid #8da498;border-radius:50%;display:flex;align-items:center;justify-content:center}
.checked .check{background:#426858;color:#fff}
.pills{display:flex;gap:12rpx;margin:32rpx 0}
.pills button{flex:1;padding:10rpx 0;border-radius:30rpx;background:transparent;border:1rpx solid #9eb1a8;font-size:22rpx}
.pills .active{background:#426858;color:#fff}
.guide{background:#294b3f;color:#fff;border-radius:42rpx;padding:50rpx 30rpx;text-align:center}
.guide>view{font-family:serif;font-size:42rpx;margin:34rpx 0 12rpx}
.guide>text{display:block;opacity:.65;font-size:22rpx}
.guide b{display:block;font-size:58rpx;margin-top:36rpx}
.guide-actions{display:grid;grid-template-columns:1fr 1.5fr 1fr;gap:12rpx;margin-top:24rpx}
.guide-actions button{border-radius:28rpx}
.month-title{text-align:center;font-size:34rpx;margin:40rpx 0 28rpx}
.calendar{display:grid;grid-template-columns:repeat(7,1fr);gap:12rpx;text-align:center}
.calendar>text{font-size:21rpx;color:#78827c}
.cell{height:58rpx;line-height:58rpx;border-radius:50%;font-size:23rpx}
.settings{background:rgba(255,253,248,.66);border-radius:34rpx;padding:0 28rpx;margin-top:48rpx}
.setting{padding:30rpx 0;border-bottom:1rpx solid #ebe4d7}
.foot{text-align:center;margin-top:48rpx}
.overlay{position:fixed;z-index:30;inset:0;background:rgba(32,43,38,.4);display:flex;align-items:flex-end}
.sheet{width:100%;background:#f5f1e8;border-radius:46rpx 46rpx 0 0;padding:46rpx 36rpx calc(46rpx + env(safe-area-inset-bottom))}
.sheet-title{font-family:serif;font-size:42rpx;margin:16rpx 0}
.moods{display:flex;flex-wrap:wrap;gap:12rpx;margin:28rpx 0}
.moods button{font-size:22rpx;border-radius:28rpx;background:#fffdf8;padding:8rpx 20rpx;margin:0}
.moods .active{background:#f0d9d2;color:#7a4036}
.move-gallery{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin-top:26rpx}
.move-card{overflow:hidden;background:#fffdf8;border-radius:28rpx;box-shadow:0 10rpx 30rpx rgba(41,75,63,.08)}
.move-card image{display:block;width:100%;height:220rpx;background:#ebe4d7}
.move-card>view{padding:20rpx}.move-card strong{display:block;font-size:25rpx;line-height:1.45}.move-card text{display:block;color:#78827c;font-size:21rpx;line-height:1.5;margin-top:8rpx}
.audio-card{background:#fffdf8;border-radius:40rpx;padding:44rpx 30rpx;text-align:center;margin:44rpx 0 24rpx}
.audio-symbol{width:100rpx;height:100rpx;line-height:100rpx;border-radius:50%;background:#dce7df;color:#294b3f;font-size:48rpx;margin:0 auto 28rpx}
.audio-move{font-family:serif;font-size:40rpx;margin-bottom:12rpx}.audio-time{font-size:21rpx;color:#78827c}
.audio-error{background:#f0d9d2;color:#7a4036;border-radius:20rpx;padding:18rpx;margin-bottom:22rpx;font-size:22rpx}.audio-finish{width:100%;margin-top:18rpx}
.share-home{margin-top:18rpx;background:rgba(255,255,255,.14)!important;color:#fff!important;border:1rpx solid rgba(255,255,255,.32);border-radius:28rpx;font-size:25rpx}
.share-result{width:100%;margin-top:10rpx}.result-done{width:100%;margin-top:16rpx}



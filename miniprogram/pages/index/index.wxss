.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 42rpx 38rpx calc(48rpx + env(safe-area-inset-bottom));
  overflow: hidden;
}

.topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #718078;
  font-size: 23rpx;
  letter-spacing: 4rpx;
}

.seal {
  width: 68rpx;
  height: 68rpx;
  border: 2rpx solid #9a584d;
  border-radius: 50%;
  color: #9a584d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: serif;
  font-size: 30rpx;
  letter-spacing: 0;
}

.intro { margin-top: 56rpx; }
.greeting { color: #718078; font-size: 24rpx; }
.title {
  margin-top: 15rpx;
  color: #253a31;
  font-family: serif;
  font-size: 62rpx;
  line-height: 1.2;
}
.subtitle { margin-top: 16rpx; color: #8b938f; font-size: 25rpx; }

.check-area {
  position: relative;
  width: 390rpx;
  height: 390rpx;
  margin: 56rpx auto 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-area::before,
.check-area::after {
  content: '';
  position: absolute;
  border: 1rpx solid rgba(54, 91, 75, .13);
  border-radius: 50%;
}
.check-area::before { inset: 18rpx; }
.check-area::after { inset: 0; }

.check-button {
  position: relative;
  z-index: 3;
  width: 292rpx;
  height: 292rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  color: #fff;
  background: #355d4d;
  box-shadow: 0 28rpx 60rpx rgba(53, 93, 77, .22), inset 0 0 0 3rpx rgba(255,255,255,.16);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: transform .18s ease, background .35s ease;
}
.check-button-hover { transform: scale(.96); }
.check-button.checked { background: #a15b4f; }
.check-symbol { font-family: serif; font-size: 88rpx; line-height: 1; }
.check-button text { margin-top: 22rpx; font-size: 25rpx; letter-spacing: 3rpx; }

.spark {
  position: absolute;
  z-index: 2;
  left: 187rpx;
  top: 187rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50% 50% 50% 0;
  background: #c77967;
  opacity: 0;
}
.celebrate .spark { animation: bloom .9s ease-out forwards; }
.spark-1 { --x: 0rpx; --y: -184rpx; }
.spark-2 { --x: 130rpx; --y: -130rpx; }
.spark-3 { --x: 184rpx; --y: 0rpx; }
.spark-4 { --x: 130rpx; --y: 130rpx; }
.spark-5 { --x: 0rpx; --y: 184rpx; }
.spark-6 { --x: -130rpx; --y: 130rpx; }
.spark-7 { --x: -184rpx; --y: 0rpx; }
.spark-8 { --x: -130rpx; --y: -130rpx; }
@keyframes bloom {
  0% { opacity: 0; transform: translate(0, 0) rotate(0deg) scale(.2); }
  35% { opacity: 1; }
  100% { opacity: 0; transform: translate(var(--x), var(--y)) rotate(160deg) scale(1.3); }
}

.message {
  min-height: 45rpx;
  text-align: center;
  color: #7c8781;
  font-size: 26rpx;
  transition: color .3s ease;
}
.message.done { color: #8c4c42; }

.week-card {
  margin-top: 64rpx;
  padding: 30rpx 26rpx 28rpx;
  border-radius: 34rpx;
  background: rgba(255, 253, 248, .72);
  box-shadow: 0 15rpx 42rpx rgba(58, 71, 64, .055);
}
.week-head { display: flex; align-items: center; justify-content: space-between; }
.week-head > text:first-child { font-family: serif; font-size: 31rpx; }
.week-note { color: #929a96; font-size: 21rpx; }
.week-row { display: grid; grid-template-columns: repeat(7, 1fr); margin-top: 27rpx; }
.week-day { text-align: center; }
.week-label { color: #929a96; font-size: 20rpx; }
.week-dot {
  width: 54rpx;
  height: 54rpx;
  margin: 13rpx auto 0;
  border-radius: 50%;
  color: #6f7b75;
  background: #ece7dc;
  font-size: 21rpx;
  line-height: 54rpx;
  box-sizing: border-box;
}
.week-dot.checked { color: #fff; background: #557665; }
.week-dot.today { box-shadow: 0 0 0 3rpx #c57b69; }
.week-dot.future { color: #bbbdbb; background: transparent; }

.numbers {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 50rpx 0 0;
}
.number-item { min-width: 190rpx; text-align: center; }
.number { display: block; color: #355d4d; font-family: serif; font-size: 52rpx; }
.number-label { display: block; margin-top: 7rpx; color: #8b938f; font-size: 21rpx; }
.divider { width: 1rpx; height: 60rpx; background: #d8d3c9; }
.privacy { margin-top: 54rpx; text-align: center; color: #a4a7a5; font-size: 20rpx; }

page{background:#f5f1e8;color:#24332d;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}button::after{border:0}button{font-size:28rpx}.page{min-height:100vh;padding:42rpx 36rpx 180rpx;box-sizing:border-box}.eyebrow{color:#78827c;font-size:24rpx;letter-spacing:3rpx;margin-bottom:12rpx}.title{font-family:serif;font-size:54rpx;line-height:1.25;margin:0 0 14rpx}.subtle{color:#78827c;font-size:26rpx;line-height:1.7}.between{display:flex;align-items:center;justify-content:space-between}.primary{background:#426858!important;color:#fff!important;border-radius:30rpx;padding:8rpx 28rpx;font-weight:600}.ghost{background:#fffdf8!important;color:#426858!important;border-radius:28rpx}.danger{background:#f0d9d2!important;color:#7a4036!important}.back{width:76rpx;height:76rpx;padding:0;border-radius:50%;background:#fffdf8!important;font-size:46rpx;line-height:76rpx;margin:0 0 30rpx}
